# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local database (SQLite file + automatic pre-migration backups)
/data/

# personal yard config (config/greenkeeper.example.json is the committed example)
/config/greenkeeper.config.json
/personal/

# Claude/Playwright automation artifacts
.playwright-mcp/

# test output
/test-results/
/playwright-report/
